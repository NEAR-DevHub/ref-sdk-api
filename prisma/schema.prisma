generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TokenBalanceHistory {
  id              String   @id @default(uuid())
  account_id      String
  token_id        String
  period          String   // e.g., "1Y", "1M", "1W", etc.
  balance_history Json     // Array of { timestamp, date, balance }
  fromBlock       Int      // oldest block in the history
  toBlock         Int      // latest block stored for this period
  timestamp       DateTime @default(now())

  @@index([account_id, token_id, period])
  @@unique([account_id, token_id, period], name: "account_id_token_id_period")
}

model IntentsBalanceHistory {
  id              String   @id @default(uuid())
  account_id      String
  period          String   // e.g., "1Y", "1M", "1W", etc.
  balance_history Json     // Array of { timestamp, date, tokens: [{token_id, balance}], totalTokens }
  fromBlock       Int      // oldest block in the history
  toBlock         Int      // latest block stored for this period
  timestamp       DateTime @default(now())

  @@index([account_id, period])
  @@unique([account_id, period], name: "account_id_period")
}


model RpcRequest {
  id           String   @id @default(uuid())
  requestHash  String
  endpoint     String
  requestBody  Json
  responseBody Json
  timestamp    DateTime @default(now())

  @@index([timestamp])
}

model FTToken {
  id                 String   @id @default(uuid())
  account_id         String   @unique
  totalCumulativeAmt Float
  fts                Json
  timestamp          DateTime @default(now())
}

model NearPrice {
  id        String   @id @default(uuid())
  price     Float
  source    String
  timestamp DateTime @default(now())
}

model AccountBlockExistence {
  id          Int      @id @default(autoincrement())
  accountId   String
  blockHeight Int
  exists      Boolean
  timestamp   DateTime @default(now())

  @@unique([accountId, blockHeight])
  @@index([accountId, blockHeight])
}

model TransferHistory {
  cacheKey   String   @id
  data       Json
  timestamp  DateTime @default(now())
}

model Treasury {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime
  createdBy String
  instanceAccount String
  daoAccount String
  lockupContract String
}